# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is already in .gitignore.
# In production these same variables go in:
#   Vercel > your project > Settings > Environment Variables
# ---------------------------------------------------------------------------

# --- SUPABASE (required) ---------------------------------------------------
# Dashboard: supabase.com > your project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# "anon public" key — safe to expose in the browser, read-only blog fetching.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key — SECRET, server-only. Bypasses Row Level Security and is
# used to insert leads/reviews. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI CHATBOT (required for the chat widget) -----------------------------
# Which provider the /api/chat route calls. Two options — note these are two
# DIFFERENT companies with confusingly similar names:
#
#   groq  -> Groq (groq.com). Fast, generous free tier. Key starts "gsk_".
#   grok  -> Grok by xAI (x.ai). Paid. Key starts "xai-".
#
# Defaults to "groq" if left blank.
AI_PROVIDER=groq

# Set the key that matches your chosen provider. The other can stay empty.
# Get a Groq key at: https://console.groq.com/keys
GROQ_API_KEY=
# Get an xAI key at: https://console.x.ai
XAI_API_KEY=

# Optional — override the default model for your provider.
#   groq default: openai/gpt-oss-120b
#   grok default: grok-4-fast
AI_MODEL=

# --- EMAIL NOTIFICATIONS (optional) ----------------------------------------
# If both are set, a notification email is sent on every new lead.
# If unset, forms still work — the email step is skipped silently.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=

# --- ANALYTICS (optional) --------------------------------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
